POSTGRES_DB=inkdesk
POSTGRES_USER=inkdesk
POSTGRES_PASSWORD=inkdesk
POSTGRES_PORT=15432

MINIO_ROOT_USER=inkdesk
MINIO_ROOT_PASSWORD=inkdeskminio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

INKDESK_SERVER_PORT=8080
INKDESK_WEB_PORT=3000
# Optional Docker build proxy. On Docker Desktop, use host.docker.internal for a local proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,local-postgres,local-server
INKDESK_ENV=local
INKDESK_MIGRATION_LOCK_TIMEOUT_SECONDS=30
INKDESK_AGENT_RUNTIME=langgraph
INKDESK_AGENT_PROVIDER_PROFILE=openai
INKDESK_AGENT_MODEL=gpt-4.1-mini
INKDESK_AGENT_API_KEY=
INKDESK_AGENT_BASE_URL=
INKDESK_AGENT_CONNECT_TIMEOUT_SECONDS=2
INKDESK_AGENT_READ_TIMEOUT_SECONDS=20
INKDESK_VAULT_ROOT=
INKDESK_REPO_ROOT=
# Claude Agent SDK 配置（可选；留空则读取 ~/.claude/settings.json 用户级配置）
INKDESK_CLAUDE_API_BASE_URL=
INKDESK_CLAUDE_API_TOKEN=
# 模型映射（ccswitch 场景：把 Claude 模型名映射到第三方模型）
INKDESK_CLAUDE_MODEL=
INKDESK_CLAUDE_DEFAULT_SONNET_MODEL=
INKDESK_CLAUDE_DEFAULT_HAIKU_MODEL=
INKDESK_CLAUDE_DEFAULT_OPUS_MODEL=
INKDESK_CLAUDE_MAX_TURNS=20
INKDESK_CLAUDE_MAX_BUDGET_USD=1.0
# 交互模式：SSE 流式对话 + 权限弹窗 + 中断（true=交互, false=同步 bypassPermissions）
INKDESK_CLAUDE_INTERACTIVE_MODE=true
# 权限请求超时（秒）：前端未回应时自动拒绝
INKDESK_CLAUDE_PERMISSION_TIMEOUT_SECONDS=120
# SSE 事件队列最大容量（满时丢弃 partial_message）
INKDESK_CLAUDE_SSE_QUEUE_MAXSIZE=100
INKDESK_EMBEDDING_PROVIDER_PROFILE=openai
INKDESK_EMBEDDING_MODEL=text-embedding-3-small
INKDESK_EMBEDDING_API_KEY=
INKDESK_EMBEDDING_BASE_URL=
INKDESK_ENABLE_WEB_ASSIST=true
INKDESK_ENABLE_LOCAL_SEED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
