{
  "schemaVersion": "1.0",
  "id": "test-fix",
  "version": "0.1.0",
  "status": "draft",
  "category": "engineering",
  "kind": "diagnostic",
  "summary": "[engineering/diagnostic] 从真实失败信号出发，定位并修复测试或实现缺陷",
  "inputs": [
    {
      "name": "failure_log",
      "type": "string",
      "required": true,
      "constraints": "min_length:1"
    }
  ],
  "contextRequirements": [
    {
      "name": "vault_status",
      "description": "需要确认 vault 已初始化"
    },
    {
      "name": "dev_run",
      "description": "需要当前 Dev Run 状态和阶段信息"
    }
  ],
  "outputs": [
    {
      "type": "fix_log",
      "location": "runs/<run_id>/test-fix-log.md",
      "needsReview": false
    }
  ],
  "hardGates": [
    {
      "id": "g-signal",
      "kind": "real_failure_signal_present",
      "params": {},
      "on_failure": "必须有真实失败信号——诊断型 Skill 核心安全约束"
    },
    {
      "id": "g-log",
      "kind": "required_input",
      "params": {
        "field": "failure_log"
      },
      "on_failure": "失败日志不得为空"
    }
  ],
  "capabilities": [
    "read_vault"
  ],
  "writePolicy": {
    "canonicalWiki": "denied",
    "runArtifacts": "allowed",
    "codeRepository": "delegated"
  },
  "verification": [
    {
      "kind": "lint",
      "description": "contract structural/semantic/safety lint 全部通过"
    }
  ],
  "nextSkills": [
    {
      "skillId": "problem-solve"
    },
    {
      "skillId": "deposit-answer"
    }
  ],
  "supportedRuntimes": [
    "inkdesk"
  ]
}