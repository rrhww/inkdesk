{
  "schemaVersion": "1.0",
  "id": "test-prep",
  "version": "0.1.0",
  "status": "draft",
  "category": "engineering",
  "kind": "producer",
  "summary": "[engineering/producer] 基于 PRD、技术方案和变更范围生成测试计划",
  "inputs": [
    {
      "name": "change_scope",
      "type": "string",
      "required": true,
      "constraints": "min_length:1"
    },
    {
      "name": "solution_doc",
      "type": "string",
      "required": true,
      "constraints": "path to solution"
    }
  ],
  "contextRequirements": [
    {
      "name": "vault_status",
      "description": "需要确认 vault 已初始化"
    },
    {
      "name": "dev_run",
      "description": "需要当前 Dev Run 状态和阶段信息"
    }
  ],
  "outputs": [
    {
      "type": "test_plan",
      "location": "runs/<run_id>/test-plan.md",
      "needsReview": false
    }
  ],
  "hardGates": [
    {
      "id": "g-scope",
      "kind": "required_input",
      "params": {
        "field": "change_scope"
      },
      "on_failure": "变更范围不得为空"
    },
    {
      "id": "g-solution",
      "kind": "artifact_exists",
      "params": {
        "field": "solution_doc"
      },
      "on_failure": "方案文档必须存在"
    }
  ],
  "capabilities": [
    "read_vault"
  ],
  "writePolicy": {
    "canonicalWiki": "denied",
    "runArtifacts": "allowed",
    "codeRepository": "delegated"
  },
  "verification": [
    {
      "kind": "lint",
      "description": "contract structural/semantic/safety lint 全部通过"
    }
  ],
  "nextSkills": [
    {
      "skillId": "test-fix"
    }
  ],
  "supportedRuntimes": [
    "inkdesk"
  ]
}