{
  "schemaVersion": "1.0",
  "id": "problem-solve",
  "version": "0.1.0",
  "status": "draft",
  "category": "engineering",
  "kind": "diagnostic",
  "summary": "[engineering/diagnostic] 从报错、线上现象、近期变更和 KB 出发诊断根因并产出复盘文档",
  "inputs": [
    {
      "name": "symptom_description",
      "type": "string",
      "required": true,
      "constraints": "min_length:1"
    }
  ],
  "contextRequirements": [
    {
      "name": "vault_status",
      "description": "需要确认 vault 已初始化"
    },
    {
      "name": "dev_run",
      "description": "需要当前 Dev Run 状态和阶段信息"
    }
  ],
  "outputs": [
    {
      "type": "diagnosis",
      "location": "runs/<run_id>/diagnosis.md",
      "needsReview": false
    }
  ],
  "hardGates": [
    {
      "id": "g-symptom",
      "kind": "required_input",
      "params": {
        "field": "symptom_description"
      },
      "on_failure": "现象描述不得为空"
    }
  ],
  "capabilities": [
    "read_vault"
  ],
  "writePolicy": {
    "canonicalWiki": "denied",
    "runArtifacts": "allowed",
    "codeRepository": "delegated"
  },
  "verification": [
    {
      "kind": "lint",
      "description": "contract structural/semantic/safety lint 全部通过"
    }
  ],
  "nextSkills": [
    {
      "skillId": "deposit-answer"
    }
  ],
  "supportedRuntimes": [
    "inkdesk"
  ]
}