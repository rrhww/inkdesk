{
  "schemaVersion": "1.0",
  "id": "patch-wiki-page",
  "version": "0.1.0",
  "status": "draft",
  "category": "knowledge",
  "kind": "producer",
  "summary": "[knowledge/producer] 修改已有 wiki 页面——补充内容、更新过时信息、标记页面状态",
  "inputs": [
    {
      "name": "target_page",
      "type": "string",
      "required": true,
      "constraints": "wiki page path"
    },
    {
      "name": "patch_content",
      "type": "string",
      "required": true,
      "constraints": "min_length:1"
    }
  ],
  "contextRequirements": [
    {
      "name": "vault_status",
      "description": "需要确认 vault 已初始化"
    },
    {
      "name": "kb_meta",
      "description": "需要 KB-META.md 获取路径和元信息"
    }
  ],
  "outputs": [
    {
      "type": "patched_page",
      "location": "runs/<run_id>/patched.md",
      "needsReview": false
    }
  ],
  "hardGates": [
    {
      "id": "g-target",
      "kind": "required_input",
      "params": {
        "field": "target_page"
      },
      "on_failure": "目标页面不得为空"
    },
    {
      "id": "g-content",
      "kind": "required_input",
      "params": {
        "field": "patch_content"
      },
      "on_failure": "变更内容不得为空"
    },
    {
      "id": "g-review",
      "kind": "review_approved",
      "params": {},
      "on_failure": "提案必须已经审阅通过"
    },
    {
      "id": "g-exists",
      "kind": "artifact_exists",
      "params": {
        "field": "target_page"
      },
      "on_failure": "目标页面必须存在"
    }
  ],
  "capabilities": [
    "read_vault"
  ],
  "writePolicy": {
    "canonicalWiki": "proposal-only",
    "runArtifacts": "allowed",
    "codeRepository": "denied"
  },
  "verification": [
    {
      "kind": "lint",
      "description": "contract structural/semantic/safety lint 全部通过"
    }
  ],
  "nextSkills": [],
  "supportedRuntimes": [
    "inkdesk"
  ]
}