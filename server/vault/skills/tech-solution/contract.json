{
  "schemaVersion": "1.0",
  "id": "tech-solution",
  "version": "0.1.0",
  "status": "active",
  "category": "engineering",
  "kind": "producer",
  "summary": "[engineering/producer] 从需求描述、KB 上下文和代码仓状态生成可评审技术方案",
  "inputs": [
    {
      "name": "requirement",
      "type": "string",
      "required": true,
      "constraints": "min_length:1"
    }
  ],
  "contextRequirements": [
    {
      "name": "vault_status",
      "description": "需要确认 vault 已初始化"
    },
    {
      "name": "repository",
      "description": "读取受限的 Git 跟踪文件作为实现上下文"
    }
  ],
  "outputs": [
    {
      "type": "solution_doc",
      "location": "wiki/generated/<prd-stem>-tech-solution.md",
      "needsReview": true
    }
  ],
  "hardGates": [
    {
      "id": "g-req",
      "kind": "required_input",
      "params": {
        "field": "requirement"
      },
      "on_failure": "需求描述不得为空"
    },
    {
      "id": "g-vault",
      "kind": "vault_initialized",
      "params": {},
      "on_failure": "KB 未初始化时返回 blocked"
    },
    {
      "id": "g-schema",
      "kind": "schema_gate_passed",
      "params": {},
      "on_failure": "wiki schema 不合规时提示但允许继续（方案写作不直接写 wiki）"
    }
  ],
  "capabilities": [
    "read_vault",
    "read_repository",
    "write_proposal"
  ],
  "writePolicy": {
    "canonicalWiki": "proposal-only",
    "runArtifacts": "denied",
    "codeRepository": "denied"
  },
  "verification": [
    {
      "kind": "lint",
      "description": "contract structural/semantic/safety lint 全部通过"
    }
  ],
  "nextSkills": [
    {
      "skillId": "tech-review"
    }
  ],
  "supportedRuntimes": [
    "inkdesk"
  ]
}
