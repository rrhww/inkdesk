{
  "schemaVersion": "1.0",
  "id": "skill-router",
  "version": "0.1.0",
  "status": "draft",
  "category": "routing",
  "kind": "router",
  "summary": "[routing/router] Inkdesk 唯一宽入口——根据用户意图路由到正确的领域 Skill",
  "inputs": [
    {
      "name": "user_intent",
      "type": "string",
      "required": true,
      "constraints": "min_length:1, max_length:2000"
    }
  ],
  "contextRequirements": [
    {
      "name": "vault_status",
      "description": "需要确认 vault 已初始化"
    },
    {
      "name": "dev_run",
      "description": "需要当前 Dev Run 状态和阶段信息"
    }
  ],
  "outputs": [
    {
      "type": "routing_decision",
      "location": "runs/<run_id>/routing.json",
      "needsReview": false
    }
  ],
  "hardGates": [
    {
      "id": "g-intent",
      "kind": "required_input",
      "params": {
        "field": "user_intent"
      },
      "on_failure": "用户意图不得为空"
    },
    {
      "id": "g-vault",
      "kind": "vault_initialized",
      "params": {},
      "on_failure": "KB 未初始化时返回 blocked"
    }
  ],
  "capabilities": [
    "read_vault"
  ],
  "writePolicy": {
    "canonicalWiki": "denied",
    "runArtifacts": "allowed",
    "codeRepository": "denied"
  },
  "verification": [
    {
      "kind": "lint",
      "description": "contract structural/semantic/safety lint 全部通过"
    }
  ],
  "nextSkills": [
    {
      "skillId": "ingest-source"
    },
    {
      "skillId": "answer-from-wiki"
    },
    {
      "skillId": "deposit-answer"
    },
    {
      "skillId": "patch-wiki-page"
    },
    {
      "skillId": "run-wiki-health"
    },
    {
      "skillId": "extract-insight"
    },
    {
      "skillId": "tech-solution"
    },
    {
      "skillId": "tech-review"
    },
    {
      "skillId": "coding"
    },
    {
      "skillId": "test-prep"
    },
    {
      "skillId": "test-fix"
    },
    {
      "skillId": "problem-solve"
    }
  ],
  "supportedRuntimes": [
    "inkdesk"
  ]
}